# --- Django ---
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DATABASE_PATH=/data/db.sqlite3   # where the SQLite file lives (Docker uses a volume)
# MEDIA_ROOT=/data/media            # where uploaded .docx files are stored

# --- RAG / OpenRouter ---
OPENROUTER_API_KEY=your_api_key_here
RAG_CHAT_MODEL=openai/gpt-oss-120b:free
RAG_EMBEDDING_MODEL=text-embedding-3-large
# RAG_DEMO_MODE=True   # run fully offline (no API key) with a lexical retriever
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
MAX_UPLOAD_MB=10
ASK_RATE_LIMIT=30/min
